{
  "name": "beakcss",
  "version": "0.2.0",
  "description": "Beak CSS — a classless-only fork of Pico CSS. Pure CSS, cascade layers, no SASS, CSS variables for colors and measures.",
  "license": "MIT",
  "style": "dist/beak.min.css",
  "main": "dist/beak.min.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/beak.min.css",
    "./beak.css": "./dist/beak.css",
    "./beak.min.css": "./dist/beak.min.css",
    "./contained.css": "./dist/beak.contained.css",
    "./contained.min.css": "./dist/beak.contained.min.css",
    "./themes/*": "./dist/themes/*.css",
    "./css/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "dist/*.css"
  ],
  "keywords": [
    "css",
    "classless",
    "semantic",
    "minimal",
    "framework",
    "css-variables",
    "no-sass",
    "picocss-fork"
  ],
  "homepage": "https://beakcss.dev.ar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4lb0/beakcss.git"
  },
  "bugs": {
    "url": "https://github.com/4lb0/beakcss/issues"
  },
  "author": "4lb0",
  "publishConfig": {
    "access": "public"
  }
}
